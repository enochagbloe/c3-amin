generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  sentInvitations       OrganizationInvitation[]
  id                    String                   @id @default(uuid())
  name                  String
  username              String                   @unique
  email                 String                   @unique
  firstName             String?
  lastName              String?
  bio                   String?
  phone                 String?
  city                  String?
  status                String                   @default("active")
  role                  String                   @default("member")
  staffId               String?
  organizationId        String?
  image                 String?
  location              String?
  portfolio             String?
  reputation            Int                      @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  accounts              Account[]
  chats                 ChatSession[]
  budgetRequests        BudgetRequest[]          @relation("BudgetRequester")
  mainBudgetApprovals   BudgetRequest[]          @relation("MainBudgetApprover")
  secondBudgetApprovals BudgetRequest[]          @relation("SecondBudgetApprover")
  budgetRequestEvents   BudgetRequestEvent[]

  @@unique([organizationId, staffId])
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  email             String
  username          String?
  image             String?
  password          String?
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model ChatSession {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  title          String        @default("New Chat")
  isPinned       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       ChatMessage[]

  @@index([userId, organizationId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  timestamp DateTime    @default(now())

  @@index([sessionId, timestamp])
}

model ExpenseTracker {
  id             String   @id @default(cuid())
  name           String
  amount         Float
  date           DateTime @default(now())
  status         Status   @default(pending)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  author         String
  description    String?
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Author from MongoDb Users collection

  @@index([author])
  @@index([date])
  @@index([organizationId])
}

enum Status {
  pending
  approved
  rejected
}

model Income {
  id             String              @id @default(uuid())
  name           String
  userId         String
  amount         Float
  source         String
  description    String?
  date           DateTime            @default(now())
  createdAt      DateTime            @default(now())
  organizationId String?
  customValues   IncomeCustomValue[]

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CustomField {
  id        String    @id @default(uuid())
  userId    String
  name      String
  type      FieldType
  required  Boolean   @default(false)
  options   String[]  @default([]) // only for SELECT type
  createdAt DateTime  @default(now())

  customValues IncomeCustomValue[]
}

model IncomeCustomValue {
  id       String @id @default(uuid())
  incomeId String
  fieldId  String
  value    String // stored as string, parsed in UI

  income      Income      @relation(fields: [incomeId], references: [id])
  customField CustomField @relation(fields: [fieldId], references: [id])
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  TOGGLE
}

model Organization {
  emailSettings    OrganizationEmailSettings?
  budgetReviewerId String?
  budgetPastorId   String?
  id               String                     @id @default(uuid())
  name             String
  email            String? // contact email for the org
  bio              String? // short description / about
  industry         Industry

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        OrganizationMember[]
  expenses       ExpenseTracker[]
  income         Income[]
  budgetRequests BudgetRequest[]
  invitations    OrganizationInvitation[]
}

enum BudgetRequestStatus {
  PENDING_MAIN
  PENDING_SECOND
  APPROVED
  REJECTED
}

enum BudgetRequestStage {
  SUBMITTED
  MAIN
  SECOND
}

enum BudgetRequestAction {
  REASSIGNED
  SUBMITTED
  APPROVED
  REJECTED
}

model BudgetRequest {
  id               String               @id @default(uuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requesterId      String
  requester        User                 @relation("BudgetRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  mainApproverId   String
  mainApprover     User                 @relation("MainBudgetApprover", fields: [mainApproverId], references: [id], onDelete: Restrict)
  secondApproverId String?
  secondApprover   User?                @relation("SecondBudgetApprover", fields: [secondApproverId], references: [id], onDelete: Restrict)
  title            String
  description      String
  amount           Decimal              @db.Decimal(14, 2)
  currency         String               @default("USD")
  neededBy         DateTime?
  status           BudgetRequestStatus  @default(PENDING_MAIN)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  events           BudgetRequestEvent[]

  @@index([organizationId, requesterId, createdAt])
  @@index([organizationId, mainApproverId, status])
  @@index([organizationId, secondApproverId, status])
}

model BudgetRequestEvent {
  id        String              @id @default(uuid())
  requestId String
  request   BudgetRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User                @relation(fields: [actorId], references: [id], onDelete: Restrict)
  stage     BudgetRequestStage
  action    BudgetRequestAction
  comment   String?
  createdAt DateTime            @default(now())

  @@index([requestId, createdAt])
}

enum Industry {
  CHURCH
  RETAIL
  SHOP
  SOFTWARE
  EDUCATION
  NON_PROFIT
  FINANCE
  HEALTHCARE
  OTHER
}

model OrganizationMember {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model OrganizationEmailSettings {
  organizationId  String       @id
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromEmail       String
  apiKeyEncrypted String
  updatedAt       DateTime     @updatedAt
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model OrganizationInvitation {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User             @relation(fields: [invitedById], references: [id], onDelete: Restrict)
  email          String
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  emailStatus    String           @default("PENDING")
  emailId        String?
  emailError     String?
  lastSentAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, email, status])
}
